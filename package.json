{
  "name": "trace-db",
  "version": "0.1.0",
  "description": "A local SQLite archive and search layer for coding-agent traces.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TSHOGX/trace-db.git"
  },
  "engines": { "bun": ">=1.2.0" },
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "trace-db": "src/cli.ts",
    "tracedb": "src/cli.ts"
  },
  "files": [
    "src",
    "native/fts5-jieba/Cargo.toml",
    "native/fts5-jieba/Cargo.lock",
    "native/fts5-jieba/src",
    "native/fts5-jieba/tests",
    "native/fts5-jieba/scripts",
    "references",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "build:native": "cargo build --release --manifest-path native/fts5-jieba/Cargo.toml",
    "postinstall": "bun run build:native",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14",
    "typescript": "^5.0.0"
  }
}
