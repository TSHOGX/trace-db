#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for candidate in "$ROOT/target/release/trace-db" "$ROOT/target/debug/trace-db"; do
  if [[ -x "$candidate" ]]; then exec "$candidate" "$@"; fi
done
echo "trace-db is not built; run 'cargo build --release' first" >&2
exit 127
